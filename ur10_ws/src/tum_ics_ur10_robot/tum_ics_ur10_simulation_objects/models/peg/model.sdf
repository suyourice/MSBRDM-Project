<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="peg">

    <!-- Peg can move -->
    <static>false</static>

    <link name="link">

      <pose>0 0 0 0 0 0</pose>

      <!-- Inertial properties: very light 3D printed object -->
      <inertial>
        <mass>0.02</mass> <!-- 20 grams -->

        <!-- Rough inertia for a small cylinder -->
        <inertia>
          <ixx>2e-5</ixx>
          <iyy>2e-5</iyy>
          <izz>1e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Collision -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>file:///root/MSBRDM/MSBRDM-Project/ur10_ws/src/tum_ics_ur10_robot/tum_ics_ur10_simulation_objects/models/peg/meshes/object_cylinder.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>500000</kp>
              <kd>20</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- Visual -->
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>

    </link>
  </model>
</sdf>
